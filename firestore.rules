rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /recipes/{recipeId} {
      // Only authenticated users can read their own recipes
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Create: must be authenticated, userId must match, validate all fields
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.category in ['Breakfast', 'Lunch', 'Dinner', 'Dessert']
        && request.resource.data.difficulty in ['Easy', 'Medium', 'Hard']
        && request.resource.data.cookTime is int
        && request.resource.data.cookTime >= 1
        && request.resource.data.cookTime <= 600
        && (
          !('servings' in request.resource.data)
          || request.resource.data.servings == null
          || (request.resource.data.servings is int
              && request.resource.data.servings >= 1
              && request.resource.data.servings <= 20)
        )
        && (
          !('notes' in request.resource.data)
          || request.resource.data.notes == null
          || (request.resource.data.notes is string
              && request.resource.data.notes.size() <= 300)
        );

      // Update: must be authenticated, userId must match both old and new, validate all fields
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.category in ['Breakfast', 'Lunch', 'Dinner', 'Dessert']
        && request.resource.data.difficulty in ['Easy', 'Medium', 'Hard']
        && request.resource.data.cookTime is int
        && request.resource.data.cookTime >= 1
        && request.resource.data.cookTime <= 600
        && (
          !('servings' in request.resource.data)
          || request.resource.data.servings == null
          || (request.resource.data.servings is int
              && request.resource.data.servings >= 1
              && request.resource.data.servings <= 20)
        )
        && (
          !('notes' in request.resource.data)
          || request.resource.data.notes == null
          || (request.resource.data.notes is string
              && request.resource.data.notes.size() <= 300)
        );

      // Delete: only the owner can delete
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
